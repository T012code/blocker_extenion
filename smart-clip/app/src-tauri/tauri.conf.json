{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Clip",
  "mainBinaryName": "SmartClip",
  "version": "1.0.0",
  "identifier": "dev.layo.smartclip",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Layó",
    "homepage": "https://layothedeveloper.com",
    "copyright": "Developed by Layó",
    "category": "Utility",
    "shortDescription": "Your clipboard on all your PCs",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
