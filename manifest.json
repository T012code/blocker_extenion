{
  "manifest_version": 3,
  "name": "Layo's Advanced Blocker",
  "short_name": "Layo Blocker",
  "version": "1.0.0",
  "description": "Blocks ads, trackers, YouTube ads, cryptominers and known malware sites, with privacy and security controls.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Layo's Advanced Blocker",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "scripting",
    "webNavigation",
    "privacy",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "trackers", "enabled": true, "path": "rules/trackers.json" },
      { "id": "security", "enabled": true, "path": "rules/security.json" },
      { "id": "strip_params", "enabled": true, "path": "rules/strip_params.json" },
      { "id": "privacy_signals", "enabled": true, "path": "rules/privacy_signals.json" },
      { "id": "block_pings", "enabled": true, "path": "rules/block_pings.json" },
      { "id": "social", "enabled": false, "path": "rules/social.json" },
      { "id": "hide_referrer", "enabled": false, "path": "rules/hide_referrer.json" },
      { "id": "https_upgrade", "enabled": false, "path": "rules/https_upgrade.json" }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["src/blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
